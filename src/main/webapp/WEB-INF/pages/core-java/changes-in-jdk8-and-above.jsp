<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Changes in JDK 8 and Above</title>
    <link rel="stylesheet" type="text/css" href="/style.css">
</head>
<body>
    <%@ include file="/WEB-INF/pages/header.jsp" %>
    <div class="container">
        <h1>Changes in JDK 8 and Above</h1>

        <h2>JDK 8 (March 2014)</h2>
        <ul>
            <li>Lambda Expressions</li>
            <li>Streams API</li>
            <li>Date and Time API (java.time package)</li>
            <li>Default and static methods in interfaces</li>
            <li>Type Annotations</li>
            <li>Nashorn JavaScript Engine</li>
        </ul>

        <h2>JDK 9 (September 2017)</h2>
        <ul>
            <li>Module System (Project Jigsaw)</li>
            <li>JShell (Read-Eval-Print Loop)</li>
            <li>Stream API Improvements</li>
            <li>Private Interface Methods</li>
        </ul>

        <h2>JDK 10 (March 2018)</h2>
        <ul>
            <li>Local-Variable Type Inference (var)</li>
            <li>Garbage Collection Improvements</li>
        </ul>

        <h2>JDK 11 (September 2018)</h2>
        <ul>
            <li>Long-Term Support (LTS)</li>
            <li>New HTTP Client API</li>
            <li>Nest-Based Access Control</li>
        </ul>

        <h2>JDK 12 and Above</h2>
        <ul>
            <li>Pattern Matching (introduced in later versions)</li>
            <li>Records</li>
            <li>Text Blocks</li>
            <li>Sealed Classes</li>
        </ul>
    </div>
</body>
</html>
